<%- include('../includes/head.ejs', { titulo: 'Lista de Alunos' }) %>
<%- include('../includes/nav.ejs') %>

<div class="container">
    <div class="header-actions">
        <div>
            <h1 class="title">Alunos Matriculados</h1>
            <p style="color: var(--text-muted);">Total de <%= alunos.length %> alunos cadastrados no MySQL</p>
        </div>
        <a href="/alunos/novo" class="btn btn-primary">+ Cadastrar Aluno</a>
    </div>

    <div class="card">
        <% if (alunos.length === 0) { %>
            <div class="empty-state">
                <p>Nenhum aluno cadastrado no momento.</p>
                <a href="/alunos/novo" class="btn btn-primary" style="margin-top: 1rem;">Cadastrar Primeiro Aluno</a>
            </div>
        <% } else { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Matrícula</th>
                            <th>Curso</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% alunos.forEach(aluno => { %>
                            <tr>
                                <td><strong>#<%= aluno.id %></strong></td>
                                <td><%= aluno.nome %></td>
                                <td><%= aluno.email %></td>
                                <td><span class="badge"><%= aluno.matricula %></span></td>
                                <td><%= aluno.curso %></td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="/alunos/editar/<%= aluno.id %>" class="btn btn-secondary btn-sm">Editar</a>
                                        <form action="/alunos/excluir/<%= aluno.id %>" method="POST" onsubmit="return confirm('Deseja realmente excluir este aluno?');" style="display:inline;">
                                            <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

</body>
</html>
