<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de alunos</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <div class="container">

        <table>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Matrícula</th>
                <th>Curso</th>
            </tr>
            <% alunos.forEach(aluno=> { %>
                <tr>
                    <td>
                        <%=aluno.id %>
                    </td>
                    <td>
                        <%=aluno.nome %>
                    </td>
                    <td>
                        <%=aluno.email %>
                    </td>
                    <td>
                        <%=aluno.matricula %>
                    </td>
                    <td>
                        <%=aluno.curso %>
                    </td>

                <tr>
                    <div>
                        <a href="">Editar</a>
                        <form action="" method="post">
                            <button type="submit">Excluir</button>
                        </form>
                    </div>
                </tr>
                </tr>
                <% }) %>
        </table>
    </div>
</body>

</html>