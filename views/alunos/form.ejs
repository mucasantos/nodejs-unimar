<%- include('../includes/head.ejs', { titulo: isEdit ? 'Editar Aluno' : 'Novo Aluno' }) %>
<%- include('../includes/nav.ejs') %>

<div class="container" style="max-width: 600px;">
    <div class="header-actions">
        <h1 class="title"><%= isEdit ? 'Editar Aluno' : 'Novo Aluno' %></h1>
        <a href="/alunos" class="btn btn-secondary btn-sm">Voltar para Lista</a>
    </div>

    <div class="card">
        <% if (typeof erro !== 'undefined' && erro) { %>
            <div style="background-color: #fee2e2; color: #dc2626; padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem;">
                ⚠️ <%= erro %>
            </div>
        <% } %>

        <form action="<%= isEdit ? '/alunos/editar/' + aluno.id : '/alunos' %>" method="POST">
            <div class="form-group">
                <label for="nome">Nome Completo</label>
                <input type="text" id="nome" name="nome" value="<%= typeof aluno !== 'undefined' ? aluno.nome : '' %>" required placeholder="Ex: Lucas Silva">
            </div>

            <div class="form-group">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" value="<%= typeof aluno !== 'undefined' ? aluno.email : '' %>" required placeholder="Ex: lucas@escola.com">
            </div>

            <div class="form-group">
                <label for="matricula">Matrícula</label>
                <input type="text" id="matricula" name="matricula" value="<%= typeof aluno !== 'undefined' ? aluno.matricula : '' %>" required placeholder="Ex: MAT202610">
            </div>

            <div class="form-group">
                <label for="curso">Curso</label>
                <input type="text" id="curso" name="curso" value="<%= typeof aluno !== 'undefined' ? aluno.curso : '' %>" required placeholder="Ex: Node.js & Express">
            </div>

            <div class="form-actions">
                <a href="/alunos" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><%= isEdit ? 'Salvar Alterações' : 'Cadastrar Aluno' %></button>
            </div>
        </form>
    </div>
</div>

</body>
</html>
